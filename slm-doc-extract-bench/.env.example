# Copy to .env if you want to override defaults.

# Ollama server address (default assumes local `ollama serve`)
OLLAMA_HOST=http://localhost:11434

# Force a device for transformers backend: cuda | mps | cpu
# (auto-detected if unset)
SLMBENCH_DEVICE=

# Timeout in seconds for Ollama HTTP calls (large VLMs on CPU can be slow)
SLMBENCH_OLLAMA_TIMEOUT=300
